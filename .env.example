# Copy to .env for local development. On Vercel, set these under Project > Settings > Environment Variables.

# REQUIRED - Supabase Postgres connection string.
# Supabase > Project > Connect > "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
# (The Vercel <-> Supabase integration sets POSTGRES_URL automatically, which also works.)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

PORT=3000
TIME_ZONE=Asia/Kolkata
# APP_URL is detected automatically on Vercel; set it if you use a custom domain.
# APP_URL=https://medialab.example.com

# Only these institution domains can register (comma-separated; subdomains allowed)
ALLOWED_EMAIL_DOMAINS=alliance.edu.in
DEFAULT_COUNTRY_CODE=+91
MAX_REQUEST_DAYS=14
DUE_SOON_HOURS=2

# Demo mode shows OTP codes on screen and demo logins on the login page.
# Default: on locally, and in production until SMTP_HOST is set. Force with true/false.
# DEV_SHOW_OTP=false

# Email (OTP codes, approval emails, duration alerts). Without SMTP, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediaLab <no-reply@alliance.edu.in>

# SMS OTP via Twilio. Phone OTP is only required at registration when Twilio is set (override with PHONE_OTP=true/false).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects the daily Vercel Cron call to /api/cron/alerts (any long random string).
CRON_SECRET=

# Passwords for the seeded accounts (used only when the database is first created)
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_PASSWORD=Student@1234
