# Copy to .env and adjust. All values are optional in development.
PORT=3000
APP_URL=http://localhost:3000
TIME_ZONE=Asia/Kolkata

# Only these institution domains can register (comma-separated; subdomains allowed)
ALLOWED_EMAIL_DOMAINS=alliance.edu.in
DEFAULT_COUNTRY_CODE=+91

# Request rules
MAX_REQUEST_DAYS=14
DUE_SOON_HOURS=2

# Email (OTP codes, approval emails, duration alerts). Without SMTP, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediaLab <no-reply@alliance.edu.in>

# SMS OTP via Twilio. Without it, SMS codes are printed to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Passwords for the seeded accounts (used only when the database is first created)
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_PASSWORD=Student@1234

# Production: NODE_ENV=production turns off on-screen OTPs and requires HTTPS for cookies.
# NODE_ENV=production
# TRUST_PROXY=1
